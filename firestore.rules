rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // --- Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'somanimayank723@gmail.com' || 
        request.auth.token.email == 'palaksomani46@gmail.com' ||
        request.auth.token.email == 'somanianju46@gmail.com'
      ); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email == request.auth.token.email
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.role in ['student', 'admin']
        && (data.role == 'admin' ? (data.email == 'somanimayank723@gmail.com' || data.email == 'palaksomani46@gmail.com' || data.email == 'somanianju46@gmail.com') : true)
        && data.createdAt == request.time;
    }

    function isValidCourse(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() > 0 && data.description.size() <= 5000
        && data.price is number && data.price >= 0
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        // && data.thumbnail is string // Optional thumbnail
        && data.keys().hasAll(['title', 'description', 'price', 'createdBy', 'createdAt']);
    }

    function isValidEnrollment(data) {
      return data.userId == request.auth.uid
        && data.userName is string && data.userName.size() > 0
        && data.userEmail is string && data.userEmail.size() > 0
        && data.userPhone is string && data.userPhone.size() > 0
        && data.courseId is string && data.courseId.size() <= 128
        && data.courseTitle is string && data.courseTitle.size() > 0
        && data.amount is string && data.amount.size() > 0
        && data.status in ['pending', 'approved', 'rejected']
        && data.proofUrl is string && data.proofUrl.size() > 10
        && data.transactionId is string && data.transactionId.size() > 0 && data.transactionId.size() <= 150
        && data.createdAt == request.time;
    }

    // --- match Blocks ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Action: Presence Update
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastSeen'])) ||
        // Action: Update Profile (Student)
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'status', 'lastSeen'])) ||
        // Action: Admin Enrollment Update
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['enrolledCourses', 'role']))
      );
    }

    match /courses/{courseId} {
      allow read: if true; // Courses are public
      allow create: if isAdmin() && isValidCourse(incoming());
      allow update: if isAdmin() && isValidCourse(incoming());
      allow delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidEnrollment(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }
  }
}
